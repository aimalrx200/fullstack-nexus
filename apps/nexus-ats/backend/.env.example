# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5176

# Persistence
MONGODB_URI=mongodb://localhost:27017/nexus_ats

# Authentication Secrets
JWT_SECRET=nexus_ats_super_secret_jwt_key_development_32_chars_min
JWT_EXPIRES_IN=7d

# Cloudinary CV Asset Storage (Optional for local testing, required for production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Automated Email System (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=recruiter@nexus-ats.dev
SMTP_PASS=your_app_password
EMAIL_FROM="Nexus Careers <careers@nexus-ats.dev>"
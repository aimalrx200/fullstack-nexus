# ===========================================================================
# 🌐 CORE CLIENT NETWORKING CONFIGURATIONS
# ===========================================================================
# Backend API base endpoint (must include the /api/v1 version prefix)
# - Local Development: http://localhost:3000/api/v1
# - Cloud Production:  https://api.yourdomain.com/api/v1 (or https://your-backend.onrender.com/api/v1)
VITE_API_URL=http://localhost:3000/api/v1

# Application environment context flag: "development" | "production"
VITE_APP_ENV=development

# ===========================================================================
# ⏱️ TANSTACK QUERY CACHE LIFESPAN MANAGEMENT (Values in milliseconds)
# ===========================================================================
# --- Development Lifespans ---
# Stale after 30s | Refetch heartbeat at 1m | Garbage collected at 90s
VITE_QUERY_STALE_TIME_DEV=30000
VITE_QUERY_REFETCH_INTERVAL_DEV=60000
VITE_QUERY_GC_TIME_DEV=90000

# --- Optimized Production Lifespans ---
# Stale after 5m (300,000ms) | Heartbeat at 10m (600,000ms) | GC after 24h (86,400,000ms)
VITE_QUERY_STALE_TIME_PROD=300000
VITE_QUERY_REFETCH_INTERVAL_PROD=600000
VITE_QUERY_GC_TIME_PROD=86400000

# ===========================================================================
# 🔒 GOOGLE OAUTH SECURITY PROVIDER PARAMETERS
# ===========================================================================
# Google OAuth 2.0 Web Client ID (Public identifier for popup exchange)
# Example format: 1234567890-abcdefg123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# ===========================================================================
# 💻 SERVER & CORE NETWORKING CONFIGURATIONS
# ===========================================================================
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===========================================================================
# 🗄️ DATABASE & CACHE INFRASTRUCTURE LAYERS
# ===========================================================================
# MongoDB connection URI (Atlas or Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/key_vault_manager

# Redis cache connection URL (Optional in dev; leave empty for in-memory fallback)
# Production format: rediss://default:<password>@<host>:<port>
REDIS_URL=

# ===========================================================================
# 🔐 CRYPTOGRAPHIC KEYS & SECURITY SECRETS (Min 32 characters long)
# Generate via: openssl rand -hex 32
# ===========================================================================
JWT_SECRET=your_32_character_jwt_secret_key_minimum_length_here
REFRESH_SECRET=your_32_character_refresh_token_secret_key_here
COOKIE_SECRET=your_32_character_cookie_signature_secret_key_here

# ===========================================================================
# ⏱️ TOKEN TIMEOUTS & LIFESPAN MANAGEMENT
# ===========================================================================
# Development Lifespans (Minutes)
ACCESS_TOKEN_EXPIRY_DEV=1
REFRESH_TOKEN_EXPIRY_DEV=2

# Production Lifespans (Access in minutes, Refresh in days)
ACCESS_TOKEN_EXPIRY_PROD=15
REFRESH_TOKEN_EXPIRY_PROD=7

# Email verification token expiration window (Seconds: 86400s = 24h)
EMAIL_VERIFICATION_TOKEN_TTL=86400

# ===========================================================================
# 📧 TRANSACTIONAL MAIL DELIVERY CONFIGURATION
# (Defaults to virtual Ethereal sandbox if SMTP credentials are left blank in dev)
# ===========================================================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ===========================================================================
# 🌐 GOOGLE OAUTH SECURITY PROVIDER PARAMETERS
# ===========================================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
{
  "name": "fullstack-nexus",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/portfolio",
    "apps/key-vault-manager/frontend",
    "apps/key-vault-manager/backend"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "concurrently --kill-others \"npm run dev:key-vault\"",
    "dev:key-vault": "concurrently --delay 0,2000 -n \"KV-BACK\",\"KV-FRONT\" -c \"cyan,blue\" \"npm run dev --workspace=apps/key-vault-manager/backend\" \"npm run dev --workspace=apps/key-vault-manager/frontend\"",
    "dev:portfolio": "npm run dev --workspace=apps/portfolio"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "mongodb-memory-server@11.2.0": true
  }
}
